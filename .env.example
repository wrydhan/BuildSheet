# App (client) env — safe to ship in the bundle. Copy to apps/mobile/.env
# These are the ONLY keys allowed client-side. The anon key is public by design;
# Row Level Security is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Public base URL of the deployed web app, used to build share links
# (https://<web>/c/<slug>) and Universal/App Links. Must match the domain in
# app.json (ios.associatedDomains / android.intentFilters).
EXPO_PUBLIC_WEB_URL=https://carstory.app

# NOTE: The OpenAI key is NEVER placed here or anywhere in the client.
# It is set as a Supabase Edge Function secret:
#   supabase secrets set OPENAI_API_KEY=sk-...
# For local `supabase functions serve`, put it in supabase/functions/.env (gitignored).
#
# NO-KEY TESTING: set LLM_PROVIDER=mock (as a cloud secret, or in
# supabase/functions/.env) to run parse-build/narrate with a keyless deterministic
# stub — lets you click through the whole app with no API key or spend.
# Providers: gemini (default, needs GEMINI_API_KEY) | openai (needs OPENAI_API_KEY) | mock.
